{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}
}

(security_headers) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
	}
}

{$SITE_ADDRESS::8080} {
	root * /srv
	encode zstd gzip
	import security_headers

	handle /healthz {
		respond "OK" 200
	}

	handle /api/v1/lots/batches* {
		request_body {
			max_size 160MB
		}
		reverse_proxy {$API_UPSTREAM:http://api:8000} {
			header_up X-Real-IP {client_ip}
		}
	}

	handle /api/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy {$API_UPSTREAM:http://api:8000} {
			header_up X-Real-IP {client_ip}
		}
	}

	handle {$ADMIN_PATH:/admin*} {
		request_body {
			max_size 1MB
		}
		header Cache-Control "no-store"
		header X-Frame-Options "DENY"
		reverse_proxy {$API_UPSTREAM:http://api:8000} {
			header_up X-Real-IP {client_ip}
		}
	}

	handle /static/* {
		reverse_proxy {$API_UPSTREAM:http://api:8000} {
			header_up X-Real-IP {client_ip}
		}
	}

	handle /assets/* {
		@existing_asset file
		header @existing_asset Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		route {
			try_files {path} /index.html
			@index path /index.html
			header @index Cache-Control "no-cache"
			file_server
		}
	}
}
