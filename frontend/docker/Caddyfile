{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}
}

{$SITE_ADDRESS::80} {
	root * /srv
	encode zstd gzip

	handle /healthz {
		respond "OK" 200
	}

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:http://api:8000}
	}

	handle /admin* {
		reverse_proxy {$API_UPSTREAM:http://api:8000}
	}

	handle /static/* {
		reverse_proxy {$API_UPSTREAM:http://api:8000}
	}

	handle_path /media/* {
		root * {$MEDIA_ROOT_DIR:/app/media}
		header Cache-Control "public, max-age=604800"
		file_server
	}

	handle /assets/* {
		@existing_asset file
		header @existing_asset Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		route {
			try_files {path} /index.html
			@index path /index.html
			header @index Cache-Control "no-cache"
			file_server
		}
	}
}
