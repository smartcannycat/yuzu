# Service API Key authentication (X-API-Key header required on all endpoints, fail-closed)
ML_SERVICE_API_KEY=your_ml_service_api_key
# Optional comma-separated key pool for key rotation (takes precedence over ML_SERVICE_API_KEY)
ML_SERVICE_API_KEYS=

# Pool of Gemini API keys (comma-separated for Round-Robin rotation across projects)
GEMINI_API_KEYS=your_api_key_1,your_api_key_2,your_api_key_3

# Single key fallback (used if GEMINI_API_KEYS is empty)
GEMINI_API_KEY=

# Gemini models configuration
GEMINI_DECISION_MODEL=gemini-decision-1
GEMINI_FLASH_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.7-flash,gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite
ENABLE_GATEKEEPER=true
GEMINI_GATEKEEPER_FAIL_OPEN=true
GEMINI_RPM_LIMIT=5
GEMINI_REQUEST_TIMEOUT_MS=25000
GEMINI_SDK_MAX_ATTEMPTS=1
GEMINI_MODEL_COOLDOWN_SECONDS=120
GEMINI_KEY_COOLDOWN_SECONDS=30
GEMINI_THINKING_LEVEL=LOW

# Reliability, hedging, header preview, and batch limits
GEMINI_REQUEST_DEADLINE_SECONDS=45.0
GEMINI_HEDGE_DELAY_SECONDS=8.0
GEMINI_FAST_HEADER_TIMEOUT_SECONDS=1.2
DEFAULT_AUCTION_STRICTNESS=0.65
BATCH_POLL_INTERVAL_MS=1500
BATCH_MAX_ITEMS=10
BATCH_MAX_CONCURRENCY=3
BATCH_MAX_STORED_BATCHES=200
BATCH_TTL_SECONDS=1800
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# Image & cache configuration
CROP_FORMAT=JPEG
CROP_QUALITY=88
CROP_MIN_PX=1000
CROP_MAX_PX=1400
MAX_IMAGE_SIZE_MB=15
CACHE_DIR=.cache/sheets
REFERENCE_YEAR=2026
REFERENCE_MONTH=11
