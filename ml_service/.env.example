# Pool of Gemini API keys (comma-separated for Round-Robin rotation across projects)
GEMINI_API_KEYS=your_api_key_1,your_api_key_2,your_api_key_3

# Single key fallback (used if GEMINI_API_KEYS is empty)
GEMINI_API_KEY=

# Gemini models configuration
GEMINI_DECISION_MODEL=gemini-decision-1
GEMINI_FLASH_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.7-flash,gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite
ENABLE_GATEKEEPER=true
GEMINI_GATEKEEPER_FAIL_OPEN=true
GEMINI_RPM_LIMIT=5
GEMINI_REQUEST_TIMEOUT_MS=25000
GEMINI_SDK_MAX_ATTEMPTS=1
GEMINI_MODEL_COOLDOWN_SECONDS=120
GEMINI_THINKING_LEVEL=LOW

# Image & cache configuration
CROP_FORMAT=JPEG
CROP_QUALITY=88
CROP_MIN_PX=1000
CROP_MAX_PX=1400
MAX_IMAGE_SIZE_MB=15
CACHE_DIR=.cache/sheets
REFERENCE_YEAR=2026
