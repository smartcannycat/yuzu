# Environment: local | dev | test | production
ENVIRONMENT=local
DEBUG=True
SECRET_KEY=django-insecure-yuzu-local-secret-key-change-in-production-123456

# Allowed hosts & CORS (comma-separated strings or JSON lists)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=False

# Database (PostgreSQL)
# In Docker Compose, POSTGRES_HOST is 'db'
POSTGRES_DB=yuzu_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Keep False to run and test on PostgreSQL
USE_SQLITE=False

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Media files
MEDIA_URL=/media/
MEDIA_ROOT=media

# External services
ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_TIMEOUT_SEC=30.0
CBRF_API_URL=https://www.cbr-xml-daily.ru/daily_json.js
HTTP_CLIENT_TIMEOUT_SEC=10.0

# CBRF currency gateway (BE-05)
# Timeout for the daily_json.js request (no in-call retries)
CBRF_TIMEOUT_SEC=5.0
# Commercial JPY spread applied on top of the CBRF rate (0.03 = +3%)
CBRF_JPY_SPREAD=0.03
# DEMO VALUES - replace before deployment. Reserve rates used only when the
# source and the last valid DB set (7 days) are both unavailable. Required in
# production; the app refuses to start without it.
CBRF_FALLBACK_RATES={"eur_rub": 95.0, "usd_rub": 85.0, "jpy_rub": 0.5825, "cbrf_date": "01.01.2026"}
# Farpost parts search: per-request timeout and per-lot request budget
FARPOST_TIMEOUT_SEC=5.0
FARPOST_BUDGET_SEC=20.0
