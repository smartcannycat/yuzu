# Environment: local | dev | test | production
ENVIRONMENT=local
DEBUG=True
SECRET_KEY=django-insecure-yuzu-local-secret-key-change-in-production-123456

# Allowed hosts & CORS (comma-separated strings or JSON lists)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=False

# Database (PostgreSQL)
# In Docker Compose, POSTGRES_HOST is 'db'
POSTGRES_DB=yuzu_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Keep False to run and test on PostgreSQL
USE_SQLITE=False

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Media files
MEDIA_URL=/media/
MEDIA_ROOT=media

# External services
ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_TIMEOUT_SEC=30.0
CBRF_API_URL=https://www.cbr-xml-daily.ru/daily_json.js
HTTP_CLIENT_TIMEOUT_SEC=10.0

# Farpost parts search: per-request timeout and per-lot request budget
FARPOST_TIMEOUT_SEC=5.0
FARPOST_BUDGET_SEC=20.0
