{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": [
    ".",
    "../kit",
    "../examples/**/*.vue",
    "../examples/**/*.ts",
    "../teaching/**/*.vue",
    "../teaching/**/*.ts"
  ]
}
