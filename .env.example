# Root environment file (secrets, DB/Redis hosts, deployment domains).
# Non-secret defaults live in backend/config.toml and ml_service/config.toml.

# Database (PostgreSQL)
POSTGRES_DB=yuzu_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (required in production; use URL-safe alphanumeric/hex characters)
REDIS_PASSWORD=change-me-in-production-redis-password

# Shared secrets & API keys
SECRET_KEY=django-insecure-yuzu-local-secret-key-change-in-production-123456
# Required in production: >= 32 random characters, distinct from SECRET_KEY
JWT_SIGNING_KEY=change-me-in-production-jwt-signing-key-distinct-from-secret-key
ML_SERVICE_API_KEY=dev-ml-service-key
GEMINI_API_KEYS=
SCRAPER_PROXY_URLS=
ALEADO_USERNAME=
ALEADO_PASSWORD=

# Hosts, CORS & CBRF reserve rates (required in production)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CBRF_FALLBACK_RATES={"eur_rub":95.0,"usd_rub":85.0,"jpy_rub":0.5825,"cbrf_date":"14.11.2026"}

# Django Admin hardening (optional; DJANGO_ADMIN_URL and ADMIN_PATH must match)
# DJANGO_ADMIN_URL=ops-console/
# ADMIN_PATH=/ops-console*
# ADMIN_ALLOWED_IPS=203.0.113.10,198.51.100.0/24

# Production reverse-proxy & frontend flags (docker-compose.prod.yml)
# TRAEFIK_HOST=yuzu.nlzr.net
# HEALTHCHECK_HOST=yuzu.nlzr.net
# PROD_VITE_USE_MOCKS=false
