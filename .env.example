# Root Docker Compose overrides (optional for dev; required for prod)
# Service-specific secrets can live in ./.env (all services) or ./backend/.env + ./ml_service/.env

POSTGRES_DB=yuzu_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Shared secret between backend and ml_service (used by both docker-compose.yml and docker-compose.prod.yml)
ML_SERVICE_API_KEY=dev-ml-service-key
GEMINI_API_KEYS=
GEMINI_API_KEY=

# Aleado cross-audit credentials (optional in dev; recommended in prod)
# ALEADO_USERNAME=your_account_id
# ALEADO_PASSWORD=replace-me

# Production settings (used by docker-compose.prod.yml behind Traefik on network traefik-net)
# TRAEFIK_HOST=yuzu.nlzr.net
# SECRET_KEY=replace-with-at-least-32-character-random-secret
# ALLOWED_HOSTS=yuzu.nlzr.net,localhost,127.0.0.1
# HEALTHCHECK_HOST=yuzu.nlzr.net
# CORS_ALLOWED_ORIGINS=https://yuzu.nlzr.net
# PROD_VITE_USE_MOCKS=false
# CBRF_FALLBACK_RATES={"eur_rub":95.0,"usd_rub":85.0,"jpy_rub":0.5825,"cbrf_date":"14.11.2026"}
